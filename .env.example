# Copy this file to .env and fill in your values.

# HubSpot private-app token (read scopes are enough for a lead fetcher:
#   crm.objects.contacts.read, crm.objects.companies.read,
#   crm.objects.deals.read, crm.schemas.contacts.read)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx

# Anthropic API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Single-user login (HTTP Basic auth). Change these before deploying.
AUTH_USERNAME=you@example.com
AUTH_PASSWORD=change-me

# Optional overrides
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_RECORDS=1000
# HUBSPOT_PORTAL_ID=45094316   # only needed if account-info scope is unavailable
